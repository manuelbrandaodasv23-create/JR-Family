DATABASE_URL=postgresql+psycopg://jrfamily:jrfamily@db:5432/jrfamily
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
ACCESS_TOKEN_MINUTES=60
INVITE_MINUTES=15
CORS_ORIGINS=https://app.example.com,https://admin.example.com
LOW_BATTERY_PERCENT=15
HISTORY_RETENTION_DAYS=30
ENVIRONMENT=production
ADMIN_PANEL_ENABLED=true

# FCM/APNs via Firebase Admin SDK.
# Prefer GOOGLE_APPLICATION_CREDENTIALS outside the repository.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
